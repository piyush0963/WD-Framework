<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zomato Navbar + Spotify Carousel</title>

  <!-- ============================================================
       Tailwind CSS via CDN (Play CDN — for prototyping)
       ============================================================ -->
  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            zomato: '#e23744',
            spotify: '#1DB954',
          },
          fontFamily: {
            sans: ['Segoe UI', 'Helvetica', 'Arial', 'sans-serif'],
          },
        },
      },
    };
  </script>
</head>

<body class="bg-gray-100 font-sans min-h-screen">

  <!-- ============================================================
       TASK 1 + TASK 2: Zomato / Flipkart-style Navbar
       ------------------------------------------------------------
       - Brand logo (left)
       - Nav links: Home, Restaurants, Orders, Profile
       - Search input (center) — hidden on mobile, shown on md+
       - Hamburger menu on mobile (< md)
       ============================================================ -->
  <header class="bg-white shadow-md sticky top-0 z-50">
    <nav class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">

      <!-- ----- LEFT: Brand Logo ----- -->
      <a href="#" class="flex items-center gap-2 shrink-0">
        <span class="w-9 h-9 rounded-full bg-zomato text-white flex items-center justify-center font-bold text-lg">Z</span>
        <span class="text-xl font-extrabold text-gray-800 tracking-tight">zomato</span>
      </a>

      <!-- ----- CENTER: Search (desktop only) ----- -->
      <div class="hidden md:flex flex-1 max-w-lg mx-4">
        <div class="relative w-full">
          <input
            type="text"
            placeholder="Search for restaurants, cuisine or a dish…"
            class="w-full pl-10 pr-4 py-2 rounded-full bg-gray-100 border border-gray-200
                   text-sm focus:outline-none focus:ring-2 focus:ring-zomato/40 focus:bg-white
                   transition-all" />
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"
               fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
      </div>

      <!-- ----- RIGHT: Nav Links (desktop) ----- -->
      <ul class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-700">
        <li><a href="#" class="hover:text-zomato transition-colors">Home</a></li>
        <li><a href="#" class="hover:text-zomato transition-colors">Restaurants</a></li>
        <li><a href="#" class="hover:text-zomato transition-colors">Orders</a></li>
        <li><a href="#" class="hover:text-zomato transition-colors">Profile</a></li>
      </ul>

      <!-- ----- RIGHT: Hamburger (mobile only) ----- -->
      <button id="menuBtn" aria-label="Toggle menu"
        class="md:hidden p-2 rounded-md hover:bg-gray-100 transition-colors">
        <svg id="menuIcon" class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor"
             stroke-width="2" viewBox="0 0 24 24">
          <line x1="3" y1="6"  x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </nav>

    <!-- ----- Mobile drop-down menu (hidden by default) ----- -->
    <div id="mobileMenu" class="md:hidden hidden border-t border-gray-200 bg-white">
      <ul class="flex flex-col px-4 py-2 text-gray-700 font-medium">
        <li><a href="#" class="block py-3 border-b border-gray-100 hover:text-zomato">Home</a></li>
        <li><a href="#" class="block py-3 border-b border-gray-100 hover:text-zomato">Restaurants</a></li>
        <li><a href="#" class="block py-3 border-b border-gray-100 hover:text-zomato">Orders</a></li>
        <li><a href="#" class="block py-3 hover:text-zomato">Profile</a></li>
      </ul>
    </div>
  </header>

  <!-- ============================================================
       TASK 3 + TASK 4: Spotify-style Carousel
       ------------------------------------------------------------
       - 3 promotional slides
       - Prev / Next controls
       - Indicator dots (clickable + auto-updating)
       - Auto-advance every 4 seconds
       ============================================================ -->
  <section class="max-w-5xl mx-auto mt-10 px-4">
    <h2 class="text-center text-xs uppercase tracking-widest text-gray-500 font-semibold mb-4">
      Featured on Spotifly
    </h2>

    <!-- Carousel wrapper -->
    <div class="relative rounded-3xl overflow-hidden shadow-2xl">

      <!-- Slides container -->
      <div id="slides" class="flex transition-transform duration-500 ease-in-out">

        <!-- Slide 1 -->
        <div class="min-w-full h-72 md:h-96 flex flex-col justify-center items-center
                    text-center text-white px-8
                    bg-gradient-to-r from-purple-700 via-fuchsia-600 to-pink-500">
          <h3 class="text-3xl md:text-5xl font-extrabold drop-shadow">Discover New Beats 🎧</h3>
          <p class="mt-3 text-sm md:text-lg text-white/90 max-w-lg">
            Fresh indie tracks curated for your late-night coding sessions.
          </p>
          <button class="mt-6 bg-white text-purple-700 font-bold px-6 py-2.5 rounded-full
                         hover:scale-105 transition-transform shadow-lg">
            Explore Playlist
          </button>
        </div>

        <!-- Slide 2 -->
        <div class="min-w-full h-72 md:h-96 flex flex-col justify-center items-center
                    text-center text-white px-8
                    bg-gradient-to-r from-green-600 via-emerald-500 to-lime-400">
          <h3 class="text-3xl md:text-5xl font-extrabold drop-shadow">Go Premium 🎶</h3>
          <p class="mt-3 text-sm md:text-lg text-white/90 max-w-lg">
            Ad-free music, offline downloads, and lossless audio — all in one place.
          </p>
          <button class="mt-6 bg-black text-green-400 font-bold px-6 py-2.5 rounded-full
                         hover:scale-105 transition-transform shadow-lg">
            Upgrade Now
          </button>
        </div>

        <!-- Slide 3 -->
        <div class="min-w-full h-72 md:h-96 flex flex-col justify-center items-center
                    text-center text-white px-8
                    bg-gradient-to-r from-indigo-700 via-blue-600 to-cyan-500">
          <h3 class="text-3xl md:text-5xl font-extrabold drop-shadow">Top Charts 2025 🔥</h3>
          <p class="mt-3 text-sm md:text-lg text-white/90 max-w-lg">
            The most-streamed tracks this week, updated every Monday.
          </p>
          <button class="mt-6 bg-white text-blue-700 font-bold px-6 py-2.5 rounded-full
                         hover:scale-105 transition-transform shadow-lg">
            See Charts
          </button>
        </div>

      </div>

      <!-- ----- Prev / Next Controls ----- -->
      <button id="prevBtn" aria-label="Previous slide"
        class="absolute top-1/2 left-3 -translate-y-1/2 w-10 h-10 rounded-full
               bg-black/40 text-white flex items-center justify-center
               hover:bg-black/70 transition-colors">
        ‹
      </button>
      <button id="nextBtn" aria-label="Next slide"
        class="absolute top-1/2 right-3 -translate-y-1/2 w-10 h-10 rounded-full
               bg-black/40 text-white flex items-center justify-center
               hover:bg-black/70 transition-colors">
        ›
      </button>

      <!-- ----- Indicator Dots ----- -->
      <div id="dots" class="absolute bottom-4 left-0 right-0 flex justify-center gap-2">
        <!-- Rendered by JS -->
      </div>
    </div>
  </section>

  <p class="text-center text-sm text-gray-500 py-10">
    Resize the window below 768px to see the navbar collapse into a hamburger.
  </p>

  <!-- ============================================================
       JavaScript
       ============================================================ -->
  <script>
    /* ---------- TASK 1: Mobile hamburger toggle ---------- */
    const menuBtn   = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    /* ---------- TASK 3 & 4: Carousel logic ---------- */
    const slidesEl  = document.getElementById('slides');
    const dotsEl    = document.getElementById('dots');
    const prevBtn   = document.getElementById('prevBtn');
    const nextBtn   = document.getElementById('nextBtn');
    const total     = slidesEl.children.length;
    let current     = 0;

    /* Build indicator dots dynamically */
    for (let i = 0; i < total; i++) {
      const dot = document.createElement('button');
      dot.className =
        'w-3 h-3 rounded-full bg-white/50 transition-all duration-300';
      dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
      dot.addEventListener('click', () => goToSlide(i));
      dotsEl.appendChild(dot);
    }
    const dots = Array.from(dotsEl.children);

    /* Update transform + active dot */
    function render() {
      slidesEl.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => {
        d.className = i === current
          ? 'w-6 h-3 rounded-full bg-white transition-all duration-300'
          : 'w-3 h-3 rounded-full bg-white/50 transition-all duration-300';
      });
    }

    function goToSlide(index) {
      current = (index + total) % total;
      render();
    }

    /* Controls */
    prevBtn.addEventListener('click', () => goToSlide(current - 1));
    nextBtn.addEventListener('click', () => goToSlide(current + 1));

    /* Auto-advance every 4 seconds */
    let autoplay = setInterval(() => goToSlide(current + 1), 4000);

    /* Pause autoplay on hover (nice UX touch) */
    const carousel = slidesEl.parentElement;
    carousel.addEventListener('mouseenter', () => clearInterval(autoplay));
    carousel.addEventListener('mouseleave', () => {
      autoplay = setInterval(() => goToSlide(current + 1), 4000);
    });

    /* Initial render */
    render();
  </script>

</body>
</html>
